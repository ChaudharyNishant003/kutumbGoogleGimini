# Real local credentials — copy config.sample.php to config.php and fill in
config/config.php

# Local Docker dev credentials
.env

# Local DB backups/dumps (contain real customer data — enquiries, contacts)
database/local_backup_*.sql

# Admin-uploaded property photos (runtime content, not source)
uploads/properties/*
!uploads/properties/.gitkeep
!uploads/properties/.htaccess

# Admin-uploaded property documents (RERA certs, brochures — runtime content)
uploads/documents/*
!uploads/documents/.gitkeep
!uploads/documents/.htaccess

# OS/editor cruft
.DS_Store
Thumbs.db
.claude/

# Generated PDF exports (deliverables, not source)
*.pdf

# QA Fortress test tooling — npm deps and raw Playwright run artifacts
# (screenshots/traces/videos on failure). docs/qa/ and tests/ ARE tracked;
# these two are regenerated by `npm install` / `npx playwright test`.
node_modules/
test-results/
playwright-report/
