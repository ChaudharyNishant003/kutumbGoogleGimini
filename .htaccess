# Kutumb Realty — Apache config for shared hosting deployment.
# (Not read by PHP's built-in dev server — applies once deployed to Apache.)

RewriteEngine On

# robots.txt is generated so its Sitemap line uses the real SITE_URL.
RewriteRule ^robots\.txt$ robots.php [L]

# The deploy copies the whole repo into the web root, so folders that hold
# CLI scripts, tests, data, docs, internal PHP includes and the voice service
# must never be reachable over HTTP (e.g. tests/backend/seed-test-accounts.php
# creates an admin account). Answer 404 so their existence isn't revealed.
RewriteRule ^(scripts|tests|database|docs|voice|config|includes|node_modules|test-results)(/|$) - [R=404,L]

<FilesMatch "\.(sql|ini|md|sh|bat|yml|yaml|lock|log)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(Dockerfile|package\.json|package-lock\.json|playwright\.config\.js)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>

Options -Indexes

# Static assets and uploaded media rarely change and are served under a
# random/versioned filename already (uploads get a random hex name on
# upload) — a year-long cache is safe. Matched by extension, not directory,
# so it covers /assets/ and /uploads/ without needing per-folder .htaccess files.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|svg|ico|woff|woff2|pdf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css application/javascript text/javascript application/json image/svg+xml text/html
</IfModule>
